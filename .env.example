# Build-time override for the API base URL. Defaults to the live API subdomain:
#   https://api.actionstepscounseling.org
# Set this when building for a different target, e.g.:
#   VITE_API_BASE=/api                       (same-origin /api folder setup)
#   VITE_API_BASE=https://staging.example.com
VITE_API_BASE=

# During local development (npm run dev), the dev server can proxy /api/* calls
# to a same-origin PHP backend when VITE_API_BASE is a relative path.
# Example: VITE_API_TARGET=https://api.actionstepscounseling.org
VITE_API_TARGET=